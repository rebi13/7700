{
  "expo": {
    "name": "7700",
    "slug": "7700",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diet7700.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "운동 및 체중 데이터를 가져와 칼로리 계산에 활용합니다.",
        "NSHealthUpdateUsageDescription": "칼로리 목표 달성 데이터를 Apple Health에 기록합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "7700",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "react-native-health"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f886de8d-b2f1-433d-8c79-951158afc412"
      }
    },
    "owner": "rebi_13"
  }
}
